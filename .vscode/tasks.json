{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build (g++ + glm + glfw)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-g",
                "${file}",
                "-Iglm",
                "-Iinclude",
                "-Llib-mingw-w64",
                "-lglfw3dll",
                "-lopengl32",
                "-lglu32",
                "-lgdi32",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
